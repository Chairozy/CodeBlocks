[sub_resource type="GDScript" id="GDScript_w0wtc"]
script/source = "extends AnimatedSprite2D

var motion_y := 3
@onready var pin_y = position.y
# Called when the node enters the scene tree for the first time.
func _ready():
	create_tween().set_loops().tween_method(Callable(self, \"tween\"), 0, (motion_y * 2) - 1, 3.0)

func tween(value: int):
	if value >= motion_y:
		value = motion_y - (value % motion_y)
	position.y = pin_y - value
"

